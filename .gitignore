# Stress-test scratch output only. The reports corpus itself is versioned:
# audits, work-package reports and repair records are project memory, and an
# earlier blanket "reports/" rule silently excluded all of them from git.
reports/stress/
reports/scratch/

# Backtest outputs (artifacts)
backtests/

# Case library (artifacts)
case_library/

# Output (artifacts)
output/

# Journal
journal/

# Temporary
tmp/
*.tmp

# Kimi WebBridge
.kimi-webbridge/

# Old artifacts
outputs/
.playwright-cli/

# Analysis run evidence packages (large binary artifacts, ~GBs)
analysis_runs/

# Temporary verification artifacts
tmp_verification_charts_review/
dummy.png
dummy_clean.png

# Generated run/evaluation artifact bundles (keep code, exclude outputs)
tests/vision/cases/
evaluation/pilot_rc1/
evaluation/calibration_set/
pilot_v1/reviewer_packs/
# Contents ignored, not the directory itself: git cannot re-include a file
# whose parent directory is excluded, and markup cohorts must be versioned.
review_queues/*
# A completed markup.json is expert human judgement about real charts -- the
# scarcest asset in this project and the only thing that turns perception
# thresholds from guesses into measurements. It does not live in an ignored
# directory.
!review_queues/markup_cohort_*/
perception_pilot_reviewer_pack.zip
